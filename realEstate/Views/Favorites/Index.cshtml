@model IEnumerable<realEstate.Models.Property>

@{
    ViewData["Title"] = "My Favorites";
}

<h2>My Favorites</h2>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">You haven't saved any properties yet. <a asp-controller="Property" asp-action="Index">Browse properties</a></div>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card">
                    @{ var img = item.Images.FirstOrDefault(); }
                    @if (img != null)
                    {
                        <img class="card-img-top" src="@img.FilePath" alt="@item.Title" />
                    }
                    <div class="card-body d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="card-title">@item.Title</h5>
                            <p class="card-text">@item.City, @item.State</p>
                            <p class="card-text">@(item.ListingPurpose == realEstate.Models.ListingPurpose.Rent ? "Monthly rent" : "Price"): @item.Price.ToString("C")@(item.ListingPurpose == realEstate.Models.ListingPurpose.Rent ? "/month" : string.Empty)</p>
                        </div>
                        <div class="text-end">
                            <a asp-controller="Property" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary mb-2">Details</a>
                            <form asp-controller="Favorites" asp-action="Remove" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="propertyId" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
