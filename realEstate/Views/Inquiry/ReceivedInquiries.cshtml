@model IEnumerable<realEstate.Models.ViewModels.InquiryListViewModel>
@{
    ViewData["Title"] = "Received Inquiries";
}

<h2>Received Inquiries</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">No inquiries received yet.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>From</th>
                <th>Property</th>
                <th>Subject</th>
                <th>Date</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.PropertyTitle</td>
                <td>
                    <img src="@item.PropertyImageUrl" alt="" style="width:80px;height:60px;object-fit:cover;margin-right:8px;" />
                    <a href="/Property/Details/@item.PropertyId">@item.PropertyTitle</a>
                </td>
                <td>@item.Subject</td>
                <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
                <td><span class="badge bg-secondary">@item.Status</span></td>
                <td><a class="btn btn-sm btn-outline-primary" href="/Inquiry/Manage/@item.Id">View</a></td>
            </tr>
        }
        </tbody>
    </table>
}
