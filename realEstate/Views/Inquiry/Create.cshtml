@model realEstate.Models.ViewModels.InquiryCreateViewModel
@{
    ViewData["Title"] = "Send Inquiry";
}

<h2>Contact Owner - @Model.PropertyTitle</h2>

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="PropertyId" />
    <div class="form-group">
        <label asp-for="Subject"></label>
        <input class="form-control" asp-for="Subject" />
        <span asp-validation-for="Subject" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Message"></label>
        <textarea class="form-control" asp-for="Message" rows="6"></textarea>
        <span asp-validation-for="Message" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Send Inquiry</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
