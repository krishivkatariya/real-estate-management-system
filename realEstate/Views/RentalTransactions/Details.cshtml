@model realEstate.Models.RentalTransaction

@{
    ViewData["Title"] = "Rental Details";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isRenter = Model.RenterId == currentUserId;
    var canManage = User.IsInRole("Admin") || Model.OwnerId == currentUserId;
}

<h2>Rental Details</h2>

<dl class="row">
    <dt class="col-sm-3">Property</dt><dd class="col-sm-9">@Model.Property?.Title</dd>
    <dt class="col-sm-3">Renter</dt><dd class="col-sm-9">@Model.Renter?.Email</dd>
    <dt class="col-sm-3">Owner</dt><dd class="col-sm-9">@Model.Owner?.Email</dd>
    <dt class="col-sm-3">Start date</dt><dd class="col-sm-9">@Model.StartDate.ToString("d")</dd>
    <dt class="col-sm-3">End date</dt><dd class="col-sm-9">@Model.EndDate.ToString("d")</dd>
    <dt class="col-sm-3">Monthly rent</dt><dd class="col-sm-9">@Model.RentAmount.ToString("C")</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
    <dt class="col-sm-3">Requested</dt><dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("g")</dd>
    @if (Model.Notes != null)
    {
        <dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@Model.Notes</dd>
    }
</dl>

<div class="d-flex flex-wrap gap-2">
    @if (Model.Status == realEstate.Models.RentalStatus.Pending && canManage)
    {
        <form asp-action="Approve" asp-route-id="@Model.RentalTransactionId" method="post"><button class="btn btn-success" type="submit">Approve</button></form>
        <form asp-action="Reject" asp-route-id="@Model.RentalTransactionId" method="post"><button class="btn btn-outline-danger" type="submit">Reject</button></form>
    }
    @if (Model.Status == realEstate.Models.RentalStatus.Approved && canManage)
    {
        <form asp-action="Activate" asp-route-id="@Model.RentalTransactionId" method="post"><button class="btn btn-success" type="submit">Activate</button></form>
    }
    @if (Model.Status == realEstate.Models.RentalStatus.Active && canManage)
    {
        <form asp-action="Complete" asp-route-id="@Model.RentalTransactionId" method="post"><button class="btn btn-primary" type="submit">Complete</button></form>
    }
    @if ((isRenter || canManage) && (Model.Status == realEstate.Models.RentalStatus.Pending || Model.Status == realEstate.Models.RentalStatus.Approved || (canManage && Model.Status == realEstate.Models.RentalStatus.Active)))
    {
        <form asp-action="Cancel" asp-route-id="@Model.RentalTransactionId" method="post"><button class="btn btn-outline-danger" type="submit">Cancel</button></form>
    }
    <a asp-action="MyRequests" class="btn btn-outline-secondary">My requests</a>
</div>