@model IEnumerable<realEstate.Models.RentalTransaction>

@{
    ViewData["Title"] = "My Rental Requests";
}

<h2>My Rental Requests</h2>

@if (!Model.Any())
{
    <p class="text-muted">You have no rental requests.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr><th>Property</th><th>Owner</th><th>Dates</th><th>Monthly rent</th><th>Status</th><th>Requested</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var rental in Model)
            {
                <tr>
                    <td>@rental.Property?.Title</td>
                    <td>@(rental.Owner?.Email ?? "Owner")</td>
                    <td>@rental.StartDate.ToString("d") - @rental.EndDate.ToString("d")</td>
                    <td>@rental.RentAmount.ToString("C")</td>
                    <td>@rental.Status</td>
                    <td>@rental.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@rental.RentalTransactionId" class="btn btn-sm btn-outline-primary">Details</a>
                        @if (rental.Status == realEstate.Models.RentalStatus.Pending || rental.Status == realEstate.Models.RentalStatus.Approved)
                        {
                            <form asp-action="Cancel" asp-route-id="@rental.RentalTransactionId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}