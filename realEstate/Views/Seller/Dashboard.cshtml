@{
    ViewData["Title"] = "Seller Dashboard";
}

<h2>Seller Dashboard</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="row">
    <div class="col-md-3">
        <div class="card p-3">
            <h5>Total Properties</h5>
            <p class="display-6">@ViewData["Total"]</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <h5>Pending Approval</h5>
            <p class="display-6">@ViewData["Pending"]</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <h5>Approved</h5>
            <p class="display-6">@ViewData["Approved"]</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <h5>Rejected</h5>
            <p class="display-6">@ViewData["Rejected"]</p>
        </div>
    </div>
</div>

<h3 class="mt-4">Booking Requests</h3>
<p class="mt-2"><a class="btn btn-primary" asp-controller="BookingRequest" asp-action="Received">View Booking Requests</a></p>
<p class="mt-3"><a class="btn btn-primary" asp-action="Create">+ Add New Property</a></p>

<h3>My Properties</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Property</th>
            <th>Type</th>
            <th>Location</th>
            <th>Price</th>
            <th>Area</th>
            <th>Date Added</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach(var p in (IEnumerable<realEstate.Models.Property>)Model)
    {
        <tr>
            <td>@p.Title</td>
            <td>@p.PropertyType</td>
            <td>@p.City</td>
            <td>@p.Price.ToString("C")</td>
            <td>@p.Area</td>
            <td>@p.CreatedAt.ToLocalTime().ToString("g")</td>
            <td><span class="badge bg-secondary">@p.ApprovalStatus</span></td>
            <td><a class="btn btn-sm btn-outline-primary" asp-controller="Property" asp-action="Details" asp-route-id="@p.Id">View</a></td>
        </tr>
    }
    </tbody>
</table>