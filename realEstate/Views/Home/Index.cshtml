@{
    ViewData["Title"] = "Find Your Place";
}

<style>
    .home-page {
        min-height: 75vh;
        background: linear-gradient(180deg, #ffffff 0%, #f2f7ff 100%);
        color: #172033;
        padding: 90px 0 70px;
    }

    .home-content {
        max-width: 850px;
        margin: 0 auto;
    }

    .home-label {
        color: #1769e0;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        margin-bottom: 24px;
    }

    .home-title {
        font-size: clamp(46px, 7vw, 82px);
        font-weight: 750;
        letter-spacing: -4px;
        line-height: 1.05;
        margin-bottom: 24px;
        color: #172033;
    }

    .home-title span {
        color: #1769e0;
    }

    .home-description {
        color: #66758a;
        font-size: 18px;
        line-height: 1.8;
        max-width: 590px;
        margin-bottom: 38px;
    }

    .home-search {
        display: flex;
        gap: 10px;
        padding: 9px;
        background: #ffffff;
        border: 1px solid #dce7f7;
        border-radius: 12px;
        box-shadow: 0 10px 35px rgba(23, 105, 224, 0.07);
        max-width: 650px;
    }

    .home-search input {
        flex: 1;
        min-width: 0;
        border: none;
        box-shadow: none !important;
        padding: 13px;
        font-size: 15px;
        background: transparent;
        color: #172033;
    }

    .home-search input:focus {
        outline: none;
    }

    .home-search input::placeholder {
        color: #8491a5;
    }

    .home-search button {
        background: #1769e0;
        color: #ffffff;
        border: none;
        padding: 13px 24px;
        border-radius: 8px;
        white-space: nowrap;
        font-weight: 600;
        transition: background 0.2s ease;
    }

    .home-search button:hover {
        background: #0f52b5;
    }

    .home-links {
        display: flex;
        gap: 25px;
        margin-top: 25px;
        align-items: center;
    }

    .home-links a {
        color: #40536e;
        font-size: 14px;
        text-decoration: none;
        border-bottom: 1px solid #a8bad3;
        padding-bottom: 4px;
        transition: color 0.2s ease, border-color 0.2s ease;
    }

    .home-links a:hover {
        color: #1769e0;
        border-color: #1769e0;
    }

    .home-divider {
        height: 1px;
        background: #dce7f5;
        margin: 85px 0 30px;
    }

    .home-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .home-bottom h5 {
        color: #172033;
        font-weight: 650;
        margin-bottom: 7px;
    }

    .home-bottom p {
        color: #758399;
        font-size: 14px;
        margin: 0;
    }

    .home-bottom a {
        color: #1769e0;
        text-decoration: none;
        font-weight: 600;
        white-space: nowrap;
        transition: color 0.2s ease;
    }

    .home-bottom a:hover {
        color: #0f52b5;
    }

    @@media (max-width: 600px) {
        .home-page {
            padding: 55px 0 45px;
        }

        .home-title {
            letter-spacing: -2px;
        }

        .home-description {
            font-size: 16px;
        }

        .home-search {
            flex-direction: column;
        }

        .home-search button {
            width: 100%;
        }

        .home-links {
            flex-wrap: wrap;
            gap: 18px;
        }

        .home-divider {
            margin: 60px 0 25px;
        }

        .home-bottom {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<div class="home-page">
    <div class="container">

        <div class="home-content">

            <div class="home-label">
                Real Estate Marketplace
            </div>

            <h1 class="home-title">
                Find a place<br />
                to <span>call yours.</span>
            </h1>

            <p class="home-description">
                Discover properties for sale and rent.
                Explore spaces, compare options, and find
                a home that fits your lifestyle.
            </p>

            <form asp-controller="Property"
                  asp-action="Index"
                  method="get"
                  class="home-search">

                <input type="text"
                       name="city"
                       placeholder="Search by city or location..."
                       aria-label="Search location" />

                <button type="submit">
                    Search Properties →
                </button>

            </form>

            <div class="home-links">

                <a asp-controller="Property"
                   asp-action="Index">
                    Browse all listings
                </a>

                <a asp-controller="Property"
                   asp-action="Create">
                    List your property
                </a>

            </div>

        </div>

        <div class="home-divider"></div>

        <div class="home-bottom">

            <div>
                <h5>Looking for your next home?</h5>
                <p>Start exploring available properties.</p>
            </div>

            <a asp-controller="Property"
               asp-action="Index">
                Explore listings ↗
            </a>

        </div>

    </div>
</div>