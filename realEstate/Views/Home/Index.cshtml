@{
    ViewData["Title"] = "Find Your Place";
}

<style>
    .home-page {
        min-height: 75vh;
        background: #faf9f7;
        color: #202020;
        padding: 90px 0 70px;
    }

    .home-content {
        max-width: 850px;
        margin: 0 auto;
    }

    .home-label {
        color: #8b65e8;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        margin-bottom: 24px;
    }

    .home-title {
        font-size: clamp(46px, 7vw, 82px);
        font-weight: 750;
        letter-spacing: -4px;
        line-height: 1.05;
        margin-bottom: 24px;
    }

    .home-title span {
        color: #8b65e8;
    }

    .home-description {
        color: #777;
        font-size: 18px;
        line-height: 1.8;
        max-width: 590px;
        margin-bottom: 38px;
    }

    .home-search {
        display: flex;
        gap: 10px;
        padding: 9px;
        background: white;
        border: 1px solid #e7e5e2;
        border-radius: 12px;
        box-shadow: 0 10px 35px rgba(0,0,0,0.04);
        max-width: 650px;
    }

    .home-search input {
        flex: 1;
        min-width: 0;
        border: none;
        box-shadow: none !important;
        padding: 13px;
        font-size: 15px;
    }

    .home-search button {
        background: #242424;
        color: white;
        border: none;
        padding: 13px 24px;
        border-radius: 8px;
        white-space: nowrap;
        transition: 0.2s;
    }

    .home-search button:hover {
        background: #8b65e8;
    }

    .home-links {
        display: flex;
        gap: 25px;
        margin-top: 25px;
        align-items: center;
    }

    .home-links a {
        color: #555;
        font-size: 14px;
        text-decoration: none;
        border-bottom: 1px solid #aaa;
        padding-bottom: 4px;
    }

    .home-links a:hover {
        color: #8b65e8;
        border-color: #8b65e8;
    }

    .home-divider {
        height: 1px;
        background: #e8e6e2;
        margin: 85px 0 30px;
    }

    .home-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .home-bottom h5 {
        font-weight: 600;
        margin-bottom: 7px;
    }

    .home-bottom p {
        color: #888;
        font-size: 14px;
        margin: 0;
    }

    .home-bottom a {
        color: #8b65e8;
        text-decoration: none;
        font-weight: 600;
        white-space: nowrap;
    }

    .home-bottom a:hover {
        color: #7048d2;
    }

    @@media (max-width: 600px) {
        .home-page {
            padding: 55px 0 45px;
        }

        .home-title {
            letter-spacing: -2px;
        }

        .home-description {
            font-size: 16px;
        }

        .home-search {
            flex-direction: column;
        }

        .home-search button {
            width: 100%;
        }

        .home-links {
            flex-wrap: wrap;
            gap: 18px;
        }

        .home-divider {
            margin: 60px 0 25px;
        }

        .home-bottom {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<div class="home-page">

    <div class="container">

        <div class="home-content">

            <div class="home-label">
                Real Estate Marketplace
            </div>

            <h1 class="home-title">
                Find a place<br />
                to <span>call yours.</span>
            </h1>

            <p class="home-description">
                Discover properties for sale and rent.
                Explore spaces, compare options, and find
                a home that fits your lifestyle.
            </p>

            <form asp-controller="Property"
                  asp-action="Index"
                  method="get"
                  class="home-search">

                <input type="text"
                       name="city"
                       placeholder="Search by city or location..."
                       aria-label="Search location" />

                <button type="submit">
                    Search Properties →
                </button>

            </form>

            <div class="home-links">

                <a asp-controller="Property"
                   asp-action="Index">
                    Browse all listings
                </a>

                <a asp-controller="Property"
                   asp-action="Create">
                    List your property
                </a>

            </div>

        </div>

        <div class="home-divider"></div>

        <div class="home-bottom">

            <div>
                <h5>Looking for your next home?</h5>
                <p>Start exploring available properties.</p>
            </div>

            <a asp-controller="Property"
               asp-action="Index">
                Explore listings ↗
            </a>

        </div>

    </div>

</div>