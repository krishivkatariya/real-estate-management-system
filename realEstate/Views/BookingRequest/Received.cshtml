@model IEnumerable<realEstate.Models.BookingRequest>

@{
    ViewData["Title"] = "Received Booking Requests";
}

<h2>Booking Requests Received</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Buyer</th>
            <th>Property</th>
            <th>Price</th>
            <th>Requested</th>
            <th>Preferred Visit</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
    @foreach(var r in Model)
    {
        <tr>
            <td>@(r.Buyer?.UserName ?? r.BuyerId)</td>
            <td>@r.Property?.Title</td>
            <td>@r.Property?.Price.ToString("C")</td>
            <td>@r.CreatedAt.ToLocalTime().ToString("g")</td>
            <td>@r.PreferredDate.ToString("d") @r.PreferredTime</td>
            <td>@r.Status</td>
            <td>
                <form asp-action="Approve" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@r.Id" />
                    <button class="btn btn-sm btn-success" type="submit">Approve</button>
                </form>
                <button class="btn btn-sm btn-danger ms-1" data-bs-toggle="modal" data-bs-target="#rejectModal-@r.Id">Reject</button>

                <div class="modal fade" id="rejectModal-@r.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form asp-action="Reject" method="post">
                                @Html.AntiForgeryToken()
                                <div class="modal-header">
                                    <h5 class="modal-title">Reject Booking</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <div class="mb-3">
                                        <label class="form-label">Reason</label>
                                        <textarea name="reason" class="form-control"></textarea>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger">Reject</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>
