@{
    ViewData["Title"] = "Buyer Dashboard";
}

<div class="container mt-3">

    <h2>@User.Identity?.Name - Welcome</h2>

    <div class="mt-4">
        <a class="btn btn-primary me-2"
           asp-controller="Property"
           asp-action="Index">
            Browse Properties
        </a>

        <a class="btn btn-outline-secondary me-2"
           asp-controller="BookingRequest"
           asp-action="MyRequests">
            My Booking Requests
        </a>

        <a class="btn btn-outline-primary"
           asp-controller="Favorites"
           asp-action="Index">
            Favorites
        </a>
    </div>

    <div class="row mt-4">

        <div class="col-md-4">
            <div class="card p-3">
                <h5>Total Favorites</h5>
                <p class="display-6">@ViewData["FavoritesCount"]</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3">
                <h5>Purchase Requests</h5>
                <p class="display-6">@ViewData["PurchaseCount"]</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3">
                <h5>Rental Requests</h5>
                <p class="display-6">@ViewData["RentalCount"]</p>
            </div>
        </div>

    </div>

</div>
