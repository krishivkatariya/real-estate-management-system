@model realEstate.Models.Property

@{
    ViewData["Title"] = "Edit Property";
}

<h2>Edit Property</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Price" class="form-label">@(Model.ListingPurpose == realEstate.Models.ListingPurpose.Rent ? "Monthly rent" : "Sale price")</label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Bedrooms" class="form-label"></label>
            <input asp-for="Bedrooms" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Bathrooms" class="form-label"></label>
            <input asp-for="Bathrooms" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Area" class="form-label"></label>
            <input asp-for="Area" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" />
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="City" class="form-label"></label>
            <input asp-for="City" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="State" class="form-label"></label>
            <input asp-for="State" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="ZipCode" class="form-label"></label>
            <input asp-for="ZipCode" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="PropertyType" class="form-label"></label>
        <select asp-for="PropertyType" class="form-select" asp-items="Html.GetEnumSelectList<realEstate.Models.PropertyType>()"></select>
    </div>
    <div class="mb-3">
        <label asp-for="ListingPurpose" class="form-label">Listing purpose</label>
        <select asp-for="ListingPurpose" class="form-select" asp-items="Html.GetEnumSelectList<realEstate.Models.ListingPurpose>()"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<realEstate.Models.PropertyStatus>()"></select>
    </div>
    <div class="mb-3">
        <label>Add Images</label>
        <input type="file" name="images" multiple class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
