
@model realEstate.Models.Property

@{
    ViewData["Title"] = "Property Details";

    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isOwner = !string.IsNullOrEmpty(currentUserId) && currentUserId == Model.OwnerId;
    var hasOpenRentalRequest = ViewData["HasOpenRentalRequest"] is bool hasRequest && hasRequest;
}

<h2>@Model.Title</h2>

<p>
    <a class="btn btn-secondary btn-sm"
       href="javascript:void(0)"
       onclick="(function(){ if (document.referrer) { history.back(); } else { window.location='@Url.Action("Index", "Property")'; } })(); return false;">
        ← Back
    </a>
</p>

<div class="row">
    <div class="col-md-8">

        @if (Model.Images != null && Model.Images.Any())
        {
            <div id="carouselExample" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">

                    @for (int i = 0; i < Model.Images.Count; i++)
                    {
                        var img = Model.Images.ElementAt(i);

                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@img.FilePath"
                                 class="d-block w-100"
                                 alt="@Model.Title" />
                        </div>
                    }

                </div>

                <button class="carousel-control-prev"
                        type="button"
                        data-bs-target="#carouselExample"
                        data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>

                <button class="carousel-control-next"
                        type="button"
                        data-bs-target="#carouselExample"
                        data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        }
        else
        {
            <img src="~/lib/bootstrap/dist/images/bootstrap-logo.svg" alt="No image" />
        }

        <h4 class="mt-3">Description</h4>
        <p>@Model.Description</p>

    </div>

    <div class="col-md-4">

        <dl class="row">

            <dt class="col-sm-4">
                @(Model.ListingPurpose == realEstate.Models.ListingPurpose.Rent ? "Monthly rent" : "Price")
            </dt>
            <dd class="col-sm-8">
                @Model.Price.ToString("C")@(Model.ListingPurpose == realEstate.Models.ListingPurpose.Rent ? "/month" : string.Empty)
            </dd>

            <dt class="col-sm-4">Listing</dt>
            <dd class="col-sm-8">@Model.ListingPurpose</dd>

            <dt class="col-sm-4">Type</dt>
            <dd class="col-sm-8">@Model.PropertyType</dd>

            <dt class="col-sm-4">Bedrooms</dt>
            <dd class="col-sm-8">@Model.Bedrooms</dd>

            <dt class="col-sm-4">Bathrooms</dt>
            <dd class="col-sm-8">@Model.Bathrooms</dd>

            <dt class="col-sm-4">Area</dt>
            <dd class="col-sm-8">@Model.Area</dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">@Model.Status</dd>

            <dt class="col-sm-4">Location</dt>
            <dd class="col-sm-8">
                @Model.Address<br />
                @Model.City, @Model.State @Model.ZipCode
            </dd>

        </dl>

        @if (User?.Identity?.IsAuthenticated ?? false)
        {
            if (User.IsInRole("Admin") || isOwner)
            {
                <a class="btn btn-primary"
                   asp-action="Edit"
                   asp-route-id="@Model.Id">
                    Edit
                </a>

                <a class="btn btn-danger"
                   asp-action="Delete"
                   asp-route-id="@Model.Id">
                    Delete
                </a>
            }

            @* Booking request button for approved properties *@

            if (!isOwner &&
                Model.ApprovalStatus == realEstate.Models.ApprovalStatus.Approved &&
                User.IsInRole("Buyer"))
            {
                <a class="btn btn-success ms-2"
                   asp-controller="BookingRequest"
                   asp-action="Create"
                   asp-route-propertyId="@Model.Id">
                    Request Booking
                </a>
            }

            @* Favorite control for Buyers *@

            if (!isOwner && User.IsInRole("Buyer"))
            {
                var userFav = false;

                try
                {
                    var favRepo = Context.RequestServices.GetService(
                        typeof(realEstate.Repositories.IFavoriteRepository))
                        as realEstate.Repositories.IFavoriteRepository;

                    var userManager = Context.RequestServices.GetService(
                        typeof(Microsoft.AspNetCore.Identity.UserManager<realEstate.Models.ApplicationUser>))
                        as Microsoft.AspNetCore.Identity.UserManager<realEstate.Models.ApplicationUser>;

                    var currentUser = userManager?.GetUserAsync(User).GetAwaiter().GetResult();

                    if (favRepo != null && currentUser != null)
                    {
                        userFav = favRepo.IsFavoritedAsync(currentUser.Id, Model.Id)
                            .GetAwaiter().GetResult();
                    }
                }
                catch
                {
                    userFav = false;
                }

                if (userFav)
                {
                    <form asp-controller="Favorites"
                          asp-action="Remove"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="propertyId" value="@Model.Id" />

                        <button type="submit" class="btn btn-danger">
                            Remove Favorite ♥
                        </button>
                    </form>
                }
                else
                {
                    <form asp-controller="Favorites"
                          asp-action="Add"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="propertyId" value="@Model.Id" />

                        <button type="submit" class="btn btn-outline-danger">
                            Add to Favorites ♡
                        </button>
                    </form>
                }
            }
        }

        @* Rental functionality *@

        @if (Model.Status == realEstate.Models.PropertyStatus.Available
            && Model.ListingPurpose == realEstate.Models.ListingPurpose.Rent)
        {
            <div class="mt-3">

                <h5>Rental</h5>

                @if (!(User?.Identity?.IsAuthenticated ?? false))
                {
                    <a class="btn btn-primary"
                       asp-controller="Account"
                       asp-action="Login"
                       asp-route-returnUrl="@Context.Request.Path">
                        Login to request this rental
                    </a>
                }
                else if (isOwner)
                {
                    <div class="alert alert-info">
                        You own this rental listing.
                    </div>
                }
                else if (hasOpenRentalRequest)
                {
                    <div class="alert alert-info">
                        You already have an open rental request for this property.
                    </div>
                }
                else
                {
                    <a class="btn btn-success"
                       asp-controller="RentalTransactions"
                       asp-action="Create"
                       asp-route-propertyId="@Model.Id">
                        Request to Rent
                    </a>
                }

            </div>
        }

    </div>
</div>