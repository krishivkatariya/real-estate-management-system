@model realEstate.Models.Property

@{
    ViewData["Title"] = "Create Property";
}

<h2>Create Property</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Pincode" class="form-label">Pincode</label>
        <input asp-for="Pincode" class="form-control" />
        <span asp-validation-for="Pincode" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Balconies" class="form-label">Balconies</label>
        <input asp-for="Balconies" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Furnishing" class="form-label">Furnishing</label>
        <select asp-for="Furnishing" class="form-select" asp-items="Html.GetEnumSelectList<realEstate.Models.Furnishing>()">
            <option value="">Select</option>
        </select>
    </div>
    <div class="mb-3">
        <label>Amenities</label>
        <div class="row">
            <div class="col-md-6">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="amenities" value="Gym" id="amenityGym" />
                    <label class="form-check-label" for="amenityGym">Gym</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="amenities" value="24/7 Security" id="amenitySecurity" />
                    <label class="form-check-label" for="amenitySecurity">24/7 Security</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="amenities" value="Swimming Pool" id="amenityPool" />
                    <label class="form-check-label" for="amenityPool">Swimming Pool</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="amenities" value="Parking" id="amenityParking" />
                    <label class="form-check-label" for="amenityParking">Parking</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="amenities" value="Garden" id="amenityGarden" />
                    <label class="form-check-label" for="amenityGarden">Garden</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="amenities" value="Lift" id="amenityLift" />
                    <label class="form-check-label" for="amenityLift">Lift</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="amenities" value="Clubhouse" id="amenityClubhouse" />
                    <label class="form-check-label" for="amenityClubhouse">Clubhouse</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="amenities" value="CCTV" id="amenityCCTV" />
                    <label class="form-check-label" for="amenityCCTV">CCTV</label>
                </div>
            </div>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Price" class="form-label">@(Model?.ListingPurpose == realEstate.Models.ListingPurpose.Rent ? "Monthly rent" : "Sale price")</label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Bedrooms" class="form-label"></label>
            <input asp-for="Bedrooms" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Bathrooms" class="form-label"></label>
            <input asp-for="Bathrooms" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Area" class="form-label"></label>
            <input asp-for="Area" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" />
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="City" class="form-label"></label>
            <input asp-for="City" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="State" class="form-label"></label>
            <input asp-for="State" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="ZipCode" class="form-label"></label>
            <input asp-for="ZipCode" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="PropertyType" class="form-label"></label>
        <select asp-for="PropertyType" class="form-select" asp-items="Html.GetEnumSelectList<realEstate.Models.PropertyType>()"></select>
    </div>
    <div class="mb-3">
        <label asp-for="ListingPurpose" class="form-label">Listing purpose</label>
        <select asp-for="ListingPurpose" class="form-select" asp-items="Html.GetEnumSelectList<realEstate.Models.ListingPurpose>()"></select>
    </div>
    <div class="mb-3">
        <label>Images</label>
        <input type="file" name="images" multiple class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
