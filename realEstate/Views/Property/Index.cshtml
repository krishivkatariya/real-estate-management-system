@model IEnumerable<realEstate.Models.Property>

@{
    ViewData["Title"] = "Properties";
}

<h2>Properties</h2>

<p>
    @if (User?.Identity?.IsAuthenticated ?? false)
    {
        <a class="btn btn-primary" asp-action="Create">Create New Property</a>
    }
</p>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card">
                @{ var img = item.Images.FirstOrDefault(); }
                @if (img != null)
                {
                    <img class="card-img-top" src="@img.FilePath" alt="@item.Title" />
                }
                <div class="card-body">
                    <h5 class="card-title">@item.Title</h5>
                    <p class="card-text">@item.City, @item.State</p>
                    <p class="card-text">Price: @item.Price.ToString("C")</p>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a>
                </div>
            </div>
        </div>
    }
</div>
