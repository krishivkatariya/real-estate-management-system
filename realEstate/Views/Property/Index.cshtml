@model realEstate.Models.ViewModels.PropertyListViewModel

@{
    ViewData["Title"] = "Properties";
}

<h2>Properties</h2>

<div class="row mb-3">
    <div class="col-md-8">
        <form method="get" class="row g-2">
            <div class="col-md-4">
                <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search title, description, address" />
            </div>
            <div class="col-md-2">
                <input type="text" name="city" value="@Model.City" class="form-control" placeholder="City" />
            </div>
            <div class="col-md-2">
                <select name="propertyType" class="form-select">
                    <option value="">All types</option>
                    @foreach (var pt in Enum.GetValues(typeof(realEstate.Models.PropertyType)).Cast<realEstate.Models.PropertyType>())
                    {
                        if (Model.PropertyType == pt)
                        {
                            <option value="@pt" selected>@pt</option>
                        }
                        else
                        {
                            <option value="@pt">@pt</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="sort" class="form-select">
                    @if (string.IsNullOrEmpty(Model.Sort)) { <option value="" selected>Sort: Newest</option> } else { <option value="">Sort: Newest</option> }
                    @if (Model.Sort == "oldest") { <option value="oldest" selected>Oldest</option> } else { <option value="oldest">Oldest</option> }
                    @if (Model.Sort == "price_asc") { <option value="price_asc" selected>Price: Low to High</option> } else { <option value="price_asc">Price: Low to High</option> }
                    @if (Model.Sort == "price_desc") { <option value="price_desc" selected>Price: High to Low</option> } else { <option value="price_desc">Price: High to Low</option> }
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary">Apply</button>
                <a class="btn btn-link" href="@Url.Action("Index", "Property")">Clear</a>
            </div>
            <div class="col-12 mt-2">
                <div class="row g-2">
                    <div class="col-md-2">
                        <input type="number" step="0.01" name="minPrice" value="@(Model.MinPrice?.ToString() ?? string.Empty)" class="form-control" placeholder="Min price" />
                    </div>
                    <div class="col-md-2">
                        <input type="number" step="0.01" name="maxPrice" value="@(Model.MaxPrice?.ToString() ?? string.Empty)" class="form-control" placeholder="Max price" />
                    </div>
                    <div class="col-md-2">
                        <input type="number" name="bedrooms" value="@(Model.Bedrooms?.ToString() ?? string.Empty)" class="form-control" placeholder="Bedrooms" />
                    </div>
                    <div class="col-md-2">
                        <input type="number" name="bathrooms" value="@(Model.Bathrooms?.ToString() ?? string.Empty)" class="form-control" placeholder="Bathrooms" />
                    </div>
                    <div class="col-md-2">
                        <select name="status" class="form-select">
                            <option value="">Any status</option>
                            @foreach (var st in Enum.GetValues(typeof(realEstate.Models.PropertyStatus)).Cast<realEstate.Models.PropertyStatus>())
                            {
                                if (Model.Status == st)
                                {
                                    <option value="@st" selected>@st</option>
                                }
                                else
                                {
                                    <option value="@st">@st</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="col-md-4 text-end">
        @if (User?.Identity?.IsAuthenticated ?? false)
        {
            <a class="btn btn-primary" asp-action="Create">Create New Property</a>
        }
    </div>
</div>

@if (Model.Properties == null || !Model.Properties.Any())
{
    <div class="alert alert-warning">No properties found matching your search. <a href="@Url.Action("Index", "Property")">Clear filters</a></div>
}
else
{
    <div class="row">
        @foreach (var item in Model.Properties)
        {
            <div class="col-md-4 mb-3">
                <div class="card">
                    @{ var img = item.Images.FirstOrDefault(); }
                    @if (img != null)
                    {
                        <img class="card-img-top" src="@img.FilePath" alt="@item.Title" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text">@item.City, @item.State</p>
                        <p class="card-text">Price: @item.Price.ToString("C")</p>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = Model.Page - 1, search = Model.Search, city = Model.City, propertyType = Model.PropertyType, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, bedrooms = Model.Bedrooms, bathrooms = Model.Bathrooms, status = Model.Status, sort = Model.Sort })">Previous</a>
            </li>
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = p, search = Model.Search, city = Model.City, propertyType = Model.PropertyType, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, bedrooms = Model.Bedrooms, bathrooms = Model.Bathrooms, status = Model.Status, sort = Model.Sort })">@p</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = Model.Page + 1, search = Model.Search, city = Model.City, propertyType = Model.PropertyType, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, bedrooms = Model.Bedrooms, bathrooms = Model.Bathrooms, status = Model.Status, sort = Model.Sort })">Next</a>
            </li>
        </ul>
    </nav>
}
