@{
    ViewData["Title"] = "Account Locked";
}

<div class="row pt-5 mt-5 justify-content-center">
    <div class="col-md-6 text-center">
        <h2 class="text-danger">Account Locked Out</h2>
        <p class="lead mt-3">Your account has been temporarily locked due to multiple failed login attempts. Please try again later.</p>
        
        <a asp-action="Login" class="btn btn-outline-primary mt-4">Return to Login</a>
    </div>
</div>
