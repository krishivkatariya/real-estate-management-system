@{
    ViewData["Title"] = "Registration Successful";
}

<div class="row mt-5 pt-5 justify-content-center">
    <div class="col-md-6 text-center">
        <h2 class="text-success"><i class="bi bi-check-circle-fill"></i> Registration Successful!</h2>
        <p class="lead mt-3">Thank you for registering with RealEstate Management System.</p>
        <p>Please check your email and verify your account to log in.</p>
        <p class="text-muted"><small>(For development, the verification link is logged in the console output).</small></p>
        
        <a asp-action="Login" class="btn btn-primary mt-4">Go to Login</a>
    </div>
</div>
