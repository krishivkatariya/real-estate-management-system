@{
    ViewData["Title"] = "Password Reset Successful";
}

<div class="row pt-5 mt-5 justify-content-center">
    <div class="col-md-6 text-center">
        <h2 class="text-success"><i class="bi bi-check-circle-fill"></i> Password Reset Successfully</h2>
        <p class="lead mt-3">Your password has been reset successfully.</p>
        
        <a asp-action="Login" class="btn btn-primary mt-4">Go to Login</a>
    </div>
</div>
