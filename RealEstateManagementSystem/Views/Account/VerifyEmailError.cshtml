@{
    ViewData["Title"] = "Email Verification Failed";
}

<div class="row mt-5 pt-5 justify-content-center">
    <div class="col-md-6 text-center">
        <h2 class="text-danger">Verification Failed</h2>
        <p class="lead mt-3">We could not verify your email address. The link may be invalid or expired.</p>
        
        <a asp-action="Login" class="btn btn-primary mt-4">Go to Login</a>
    </div>
</div>
