@{
    ViewData["Title"] = "Forgot Password Confirmation";
}

<div class="row mt-5 pt-5 justify-content-center">
    <div class="col-md-6 text-center">
        <h2 class="text-info">Check your email</h2>
        <p class="lead mt-3">If an account exists for this email address, a password reset link has been sent.</p>
        <p class="text-muted"><small>(For development, the reset link is logged in the console output).</small></p>
        
        <a asp-action="Login" class="btn btn-primary mt-4">Back to Login</a>
    </div>
</div>
