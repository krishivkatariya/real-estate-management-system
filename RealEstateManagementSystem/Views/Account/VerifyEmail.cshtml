@{
    ViewData["Title"] = "Email Verified";
}

<div class="row mt-5 pt-5 justify-content-center">
    <div class="col-md-6 text-center">
        <h2 class="text-success">Email Verified!</h2>
        <p class="lead mt-3">Your email address has been successfully verified.</p>
        <p>You can now log in to your account.</p>
        
        <a asp-action="Login" class="btn btn-primary mt-4">Login Now</a>
    </div>
</div>
