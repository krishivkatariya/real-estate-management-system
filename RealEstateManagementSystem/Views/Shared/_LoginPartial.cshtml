@using Microsoft.AspNetCore.Identity
@using RealEstateManagementSystem.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var user = await UserManager.GetUserAsync(User);
}

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    @if (User.IsInRole("Admin"))
    {
        <li class="nav-item">
            <a class="nav-link text-dark" href="#">Dashboard</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" href="#">Users</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" href="#">Properties</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" href="#">Transactions</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" href="#">Categories</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" href="#">Locations</a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" href="#">Properties</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" href="#">Favorites</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" href="#">My Transactions</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" href="#">My Properties</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" href="#">Profile</a>
        </li>
    }

    <li class="nav-item">
        <span class="nav-link text-muted">Hello, @(user?.FullName ?? User.Identity?.Name)!</span>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
    </li>
}
</ul>
