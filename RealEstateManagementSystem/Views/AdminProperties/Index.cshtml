@model IEnumerable<Property>
@{
    ViewData["Title"] = "Manage Properties";
    var properties = Model.ToList();
    var statusFilter = ViewData["StatusFilter"] as PropertyStatus?;
    var totalCount = (int?)ViewData["TotalCount"] ?? 0;
    var pendingCount = (int?)ViewData["PendingCount"] ?? 0;
    var approvedCount = (int?)ViewData["ApprovedCount"] ?? 0;
    var rejectedCount = (int?)ViewData["RejectedCount"] ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Manage Properties</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-controller="Properties" asp-action="Index" target="_blank">
        View public listing
    </a>
</div>

<partial name="_StatusMessages" />

<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a class="nav-link @(statusFilter == null ? "active" : string.Empty)" asp-action="Index">
            All <span class="badge bg-light text-dark">@totalCount</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(statusFilter == PropertyStatus.Pending ? "active" : string.Empty)"
           asp-action="Index" asp-route-status="@PropertyStatus.Pending">
            Pending <span class="badge bg-light text-dark">@pendingCount</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(statusFilter == PropertyStatus.Approved ? "active" : string.Empty)"
           asp-action="Index" asp-route-status="@PropertyStatus.Approved">
            Approved <span class="badge bg-light text-dark">@approvedCount</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(statusFilter == PropertyStatus.Rejected ? "active" : string.Empty)"
           asp-action="Index" asp-route-status="@PropertyStatus.Rejected">
            Rejected <span class="badge bg-light text-dark">@rejectedCount</span>
        </a>
    </li>
</ul>

@if (properties.Count == 0)
{
    <div class="alert alert-info">No listings match this filter.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col">Image</th>
                    <th scope="col">Listing</th>
                    <th scope="col">Owner</th>
                    <th scope="col">Location</th>
                    <th scope="col" class="text-end">Price</th>
                    <th scope="col">Status</th>
                    <th scope="col">Submitted</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var property in properties)
                {
                    <tr>
                        <td style="width: 90px;">
                            @if (property.PrimaryImage != null)
                            {
                                <img src="@property.PrimaryImage.ImageUrl" alt="@property.Title" class="img-thumbnail"
                                     style="width: 70px; height: 55px; object-fit: cover;" />
                            }
                            else
                            {
                                <span class="text-muted small">No image</span>
                            }
                        </td>
                        <td>
                            <a asp-controller="Properties" asp-action="Details" asp-route-id="@property.PropertyId">
                                @property.Title
                            </a>
                            <div class="small text-muted">@property.PropertyType?.Name</div>
                            @if (property.Status == PropertyStatus.Rejected && !string.IsNullOrWhiteSpace(property.RejectionReason))
                            {
                                <div class="small text-danger">Reason: @property.RejectionReason</div>
                            }
                        </td>
                        <td class="small">
                            @(property.Owner?.FullName ?? "Unknown")
                            <div class="text-muted">@property.Owner?.Email</div>
                        </td>
                        <td class="small">@property.Location?.DisplayName</td>
                        <td class="text-end">
                            &#8377;@property.Price.ToString("N0")
                            <div class="small text-muted">@(property.ListingType == ListingType.Sale ? "For Sale" : "For Rent")</div>
                        </td>
                        <td><partial name="_PropertyStatusBadge" model="property.Status" /></td>
                        <td class="small">@property.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td class="text-end text-nowrap">
                            @if (property.Status != PropertyStatus.Approved)
                            {
                                <form asp-action="Approve" asp-route-id="@property.PropertyId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="status" value="@statusFilter" />
                                    <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                </form>
                            }
                            @if (property.Status != PropertyStatus.Rejected)
                            {
                                <a class="btn btn-sm btn-outline-warning" asp-action="Reject" asp-route-id="@property.PropertyId">Reject</a>
                            }
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@property.PropertyId">Remove</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
