@model Property
@{
    ViewData["Title"] = "Remove Property";
}

<h1 class="h3 mb-3 text-danger">Remove Property</h1>

<partial name="_StatusMessages" />

<div class="alert alert-danger">
    As an administrator you are about to permanently remove this listing and all of its uploaded images.
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Owner</dt>
            <dd class="col-sm-9">@(Model.Owner?.FullName ?? "Unknown") (@Model.Owner?.Email)</dd>

            <dt class="col-sm-3">Property Type</dt>
            <dd class="col-sm-9">@Model.PropertyType?.Name</dd>

            <dt class="col-sm-3">Location</dt>
            <dd class="col-sm-9">@Model.Location?.DisplayName</dd>

            <dt class="col-sm-3">Price</dt>
            <dd class="col-sm-9">
                &#8377;@Model.Price.ToString("N0")
                (@(Model.ListingType == ListingType.Sale ? "For Sale" : "For Rent"))
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9"><partial name="_PropertyStatusBadge" model="Model.Status" /></dd>

            <dt class="col-sm-3">Images</dt>
            <dd class="col-sm-9">@Model.Images.Count</dd>
        </dl>

        <form asp-action="Delete" asp-route-id="@Model.PropertyId" method="post" class="mt-4">
            @Html.AntiForgeryToken()
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Yes, remove this property</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>
