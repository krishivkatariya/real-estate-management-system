@model PropertyCreateViewModel
@{
    ViewData["Title"] = "Add Property";
    var hasPropertyTypes = Model.PropertyTypes.Any();
    var hasLocations = Model.Locations.Any();
}

<h1 class="h3 mb-3">Add Property</h1>

<partial name="_StatusMessages" />

@if (!hasPropertyTypes || !hasLocations)
{
    <div class="alert alert-warning">
        An administrator must create at least one <strong>property type</strong> and one
        <strong>location</strong> before a listing can be added.
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="2 BHK apartment near metro station" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ListingType" class="form-label"></label>
                    <select asp-for="ListingType" asp-items="Html.GetEnumSelectList<ListingType>()" class="form-select">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="ListingType" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="PropertyTypeId" class="form-label"></label>
                    <select asp-for="PropertyTypeId" asp-items="Model.PropertyTypes" class="form-select">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="PropertyTypeId" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="LocationId" class="form-label"></label>
                    <select asp-for="LocationId" asp-items="Model.Locations" class="form-select">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="LocationId" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Price" class="form-label"></label>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" min="1" placeholder="4500000" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Area" class="form-label"></label>
                    <input asp-for="Area" class="form-control" type="number" step="0.01" min="1" placeholder="1200" />
                    <span asp-validation-for="Area" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Bedrooms" class="form-label"></label>
                    <input asp-for="Bedrooms" class="form-control" type="number" min="0" max="100" />
                    <span asp-validation-for="Bedrooms" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Bathrooms" class="form-label"></label>
                    <input asp-for="Bathrooms" class="form-control" type="number" min="0" max="100" />
                    <span asp-validation-for="Bathrooms" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" placeholder="Flat 402, Green Residency, MG Road" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="5"
                              placeholder="Describe the property, its condition and nearby amenities."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Images" class="form-label"></label>
                    <input asp-for="Images" class="form-control" type="file" multiple
                           accept=".jpg,.jpeg,.png,.webp" />
                    <div class="form-text">
                        Optional. Allowed types: JPG, JPEG, PNG, WEBP. Maximum 5 MB per file and 8 images per listing.
                        The first image becomes the primary image.
                    </div>
                    <span asp-validation-for="Images" class="text-danger"></span>
                </div>
            </div>

            <div class="alert alert-info mt-3 mb-0">
                New and edited listings are submitted with the status <strong>Pending</strong> until an administrator approves them.
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Submit for Approval</button>
                <a class="btn btn-outline-secondary" asp-action="MyProperties">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
