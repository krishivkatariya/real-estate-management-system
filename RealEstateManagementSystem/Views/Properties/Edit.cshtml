@model PropertyEditViewModel
@{
    ViewData["Title"] = "Edit Property";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Edit Property</h1>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.PropertyId">Back to Details</a>
</div>

<partial name="_StatusMessages" />

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Current Status</dt>
            <dd class="col-sm-9"><partial name="_PropertyStatusBadge" model="Model.CurrentStatus" /></dd>

            <dt class="col-sm-3">Owner</dt>
            <dd class="col-sm-9">@Model.OwnerName</dd>

            <dt class="col-sm-3">Created On</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>

            @if (Model.CurrentStatus == PropertyStatus.Rejected && !string.IsNullOrWhiteSpace(Model.RejectionReason))
            {
                <dt class="col-sm-3">Rejection Reason</dt>
                <dd class="col-sm-9 text-danger">@Model.RejectionReason</dd>
            }
        </dl>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.PropertyId" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="PropertyId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ListingType" class="form-label"></label>
                    <select asp-for="ListingType" asp-items="Html.GetEnumSelectList<ListingType>()" class="form-select">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="ListingType" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="PropertyTypeId" class="form-label"></label>
                    <select asp-for="PropertyTypeId" asp-items="Model.PropertyTypes" class="form-select">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="PropertyTypeId" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="LocationId" class="form-label"></label>
                    <select asp-for="LocationId" asp-items="Model.Locations" class="form-select">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="LocationId" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Price" class="form-label"></label>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" min="1" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Area" class="form-label"></label>
                    <input asp-for="Area" class="form-control" type="number" step="0.01" min="1" />
                    <span asp-validation-for="Area" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Bedrooms" class="form-label"></label>
                    <input asp-for="Bedrooms" class="form-control" type="number" min="0" max="100" />
                    <span asp-validation-for="Bedrooms" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Bathrooms" class="form-label"></label>
                    <input asp-for="Bathrooms" class="form-control" type="number" min="0" max="100" />
                    <span asp-validation-for="Bathrooms" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label class="form-label">Existing Images</label>
                    @if (Model.ExistingImages.Count == 0)
                    {
                        <p class="text-muted mb-0">This listing has no images yet.</p>
                    }
                    else
                    {
                        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
                            @foreach (var image in Model.ExistingImages)
                            {
                                <div class="col">
                                    <div class="card h-100">
                                        <img src="@image.ImageUrl" class="card-img-top" alt="Property image"
                                             style="height: 150px; object-fit: cover;" />
                                        <div class="card-body py-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="PrimaryImageId"
                                                       id="primary_@image.PropertyImageId" value="@image.PropertyImageId"
                                                       checked="@image.IsPrimary" />
                                                <label class="form-check-label small" for="primary_@image.PropertyImageId">
                                                    Use as primary image
                                                </label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="RemoveImageIds"
                                                       id="remove_@image.PropertyImageId" value="@image.PropertyImageId" />
                                                <label class="form-check-label small text-danger" for="remove_@image.PropertyImageId">
                                                    Remove this image
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="PrimaryImageId" class="text-danger d-block"></span>
                    }
                </div>

                <div class="col-12">
                    <label asp-for="Images" class="form-label"></label>
                    <input asp-for="Images" class="form-control" type="file" multiple
                           accept=".jpg,.jpeg,.png,.webp" />
                    <div class="form-text">
                        Optional. Allowed types: JPG, JPEG, PNG, WEBP. Maximum 5 MB per file and 8 images per listing.
                    </div>
                    <span asp-validation-for="Images" class="text-danger"></span>
                </div>
            </div>

            <div class="alert alert-info mt-3 mb-0">
                Saving changes to an approved or rejected listing sends it back to <strong>Pending</strong> for approval.
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a class="btn btn-outline-secondary" asp-action="MyProperties">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

