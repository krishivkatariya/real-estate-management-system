@model IEnumerable<Property>
@{
    ViewData["Title"] = "My Properties";
    var properties = Model.ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">My Properties</h1>
    <a class="btn btn-primary" asp-action="Create">+ Add Property</a>
</div>

<partial name="_StatusMessages" />

@if (properties.Count == 0)
{
    <div class="alert alert-info">
        You have not added any property yet. Click <strong>Add Property</strong> to create your first listing.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col">Image</th>
                    <th scope="col">Title</th>
                    <th scope="col">Type</th>
                    <th scope="col">Location</th>
                    <th scope="col" class="text-end">Price</th>
                    <th scope="col">Status</th>
                    <th scope="col">Created</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var property in properties)
                {
                    <tr>
                        <td style="width: 90px;">
                            @if (property.PrimaryImage != null)
                            {
                                <img src="@property.PrimaryImage.ImageUrl" alt="@property.Title" class="img-thumbnail"
                                     style="width: 70px; height: 55px; object-fit: cover;" />
                            }
                            else
                            {
                                <span class="text-muted small">No image</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@property.PropertyId">@property.Title</a>
                            @if (property.Status == PropertyStatus.Rejected && !string.IsNullOrWhiteSpace(property.RejectionReason))
                            {
                                <div class="small text-danger mt-1">
                                    <strong>Rejected:</strong> @property.RejectionReason
                                </div>
                                <div class="small text-muted">Edit the listing to send it back for approval.</div>
                            }
                        </td>
                        <td>@property.PropertyType?.Name</td>
                        <td class="small">@property.Location?.DisplayName</td>
                        <td class="text-end">
                            &#8377;@property.Price.ToString("N0")
                            <div class="small text-muted">@(property.ListingType == ListingType.Sale ? "For Sale" : "For Rent")</div>
                        </td>
                        <td><partial name="_PropertyStatusBadge" model="property.Status" /></td>
                        <td class="small">@property.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@property.PropertyId">Details</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@property.PropertyId">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@property.PropertyId">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
