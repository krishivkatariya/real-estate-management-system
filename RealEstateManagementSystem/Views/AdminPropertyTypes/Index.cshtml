@model IEnumerable<PropertyTypeListItemViewModel>
@{
    ViewData["Title"] = "Property Types";
    var items = Model.ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Property Types</h1>
    <a class="btn btn-primary" asp-action="Create">+ Add Property Type</a>
</div>

<partial name="_StatusMessages" />

<div class="alert alert-info">
    Property types are never deleted because existing listings use them. Deactivate a type instead - it
    disappears from the property form but old listings keep working.
</div>

@if (items.Count == 0)
{
    <div class="alert alert-warning">No property type has been created yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                    <th scope="col" class="text-end">Listings</th>
                    <th scope="col">State</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td class="fw-semibold">@item.PropertyType.Name</td>
                        <td class="small text-muted">@(item.PropertyType.Description ?? "-")</td>
                        <td class="text-end">@item.PropertyCount</td>
                        <td>
                            @if (item.PropertyType.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit"
                               asp-route-id="@item.PropertyType.PropertyTypeId">Edit</a>

                            <form asp-action="ToggleActive" asp-route-id="@item.PropertyType.PropertyTypeId"
                                  method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm @(item.PropertyType.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                    @(item.PropertyType.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
